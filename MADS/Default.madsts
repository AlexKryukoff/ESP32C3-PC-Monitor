        <prefix />
        <postfix>;</postfix>
        <targetData>PropertyValue</targetData>
        <operationType>None</operationType>
        <operationValue>0</operationValue>
        <roundMode>Round</roundMode>
        <modulo>false</modulo>
        <outFormat />
      </MASM_StringFormattingItem>
