<?xml version="1.0" encoding="utf-16"?>
<MADS_SerialServerSharedProperties xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <FileFormat>madsts</FileFormat>
  <FormatVersion>1</FormatVersion>
  <PortSpeed>Baud_9600</PortSpeed>
  <Encoding>ASCII</Encoding>
  <EndOfLineChar>\n</EndOfLineChar>
  <AutoConnect>false</AutoConnect>
  <AutoConnectRequest>MADS</AutoConnectRequest>
  <AutoConnectResponse>Hello MADS</AutoConnectResponse>
  <AutoConnectResponseTimeout>500</AutoConnectResponseTimeout>
  <ConnectionInterval>1000</ConnectionInterval>
  <SendMode>Stream</SendMode>
  <MessageInterval>500</MessageInterval>
  <ConnectionCheckInterval>5000</ConnectionCheckInterval>
  <DataRequest>Send Data</DataRequest>
  <DataFormatter>
    <DecimalSeparator>.</DecimalSeparator>
    <GlobalPrefix />
    <GlobalPostfix />
    <FormattingItems>
      <MASM_StringFormattingItem>
        <enable>true</enable>
        <mode>Property</mode>
        <value>CPU temperature</value>
        <prefix />
        <postfix>;</postfix>
        <targetData>PropertyValue</targetData>
        <operationType>None</operationType>
        <operationValue>0</operationValue>
        <roundMode>Round</roundMode>
        <modulo>false</modulo>
        <outFormat />
      </MASM_StringFormattingItem>
      <MASM_StringFormattingItem>
        <enable>true</enable>
        <mode>Property</mode>
        <value>GPU temperature</value>
        <prefix />
        <postfix>;</postfix>
